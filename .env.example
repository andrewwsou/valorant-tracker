# Copy this file to .env and set HENRIKDEV_API_KEY.
# The other values match the services in docker-compose.yml.

# PostgreSQL. Docker Compose publishes it on host port 5433.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/valorant?schema=public"

# Redis over the Upstash REST API. Locally this is the SRH proxy from docker-compose.yml.
UPSTASH_REDIS_REST_URL="http://localhost:8079"
UPSTASH_REDIS_REST_TOKEN="local-dev-token"

# HenrikDev VALORANT API key: https://docs.henrikdev.xyz
HENRIKDEV_API_KEY=""

# Optional: send OpenTelemetry traces and metrics to an OTLP endpoint.
# With docker-compose.observability.yml running, this is Grafana's collector.
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
