// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Match {
  id        String    @id
  map       String?
  mode      String?
  region    String?
  startedAt DateTime?

  roundsRed  Int?
  roundsBlue Int?

  players PlayerMatch[]

  @@index([startedAt])
}

/// A player is their PUUID, which never changes. The Riot ID (name#tag) can change
/// and is matched without regard to case.
model Player {
  id   String @id @default(cuid())
  /// Last known Riot ID, as HenrikDev capitalizes it. For display.
  name String
  tag  String

  puuid        String?   @unique
  /// "name#tag" lowercased (NFC), set by the app. Looks a player up by Riot ID in any
  /// capitalization. Null once another PUUID takes this Riot ID (this player renamed away).
  riotIdKey    String?   @unique
  lastSyncedAt DateTime?

  matches PlayerMatch[]
  stats   PlayerStats?
}

model PlayerMatch {
  id       String @id @default(cuid())
  matchId  String
  playerId String

  team    String?
  kills   Int?
  deaths  Int?
  assists Int?

  score Int?

  damage    Int?
  headshots Int?
  bodyshots Int?
  legshots  Int?
  agentIcon String?

  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerId])
  @@index([playerId])
  @@index([matchId])
}

/// One row per player: stats over their 10 most recent stored matches, the same
/// window and formulas as the profile page. Rebuilt from PlayerMatch by
/// refreshPlayerStats() after every sync, never incremented, so re-running a sync
/// can't double count. The leaderboard reads this table instead of every match row.
model PlayerStats {
  playerId String @id
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  // Window of the most recent matches (at most 10)
  matches Int
  wins    Int
  losses  Int
  draws   Int

  // Unrounded, so sorting is exact. The UI rounds for display.
  kd          Float // kills / max(1, deaths)
  acs         Float // combat score per round
  adr         Float // damage per round
  winRate     Float // percent of decided matches won; draws excluded
  headshotPct Float // headshots / all shots, percent

  trackerScore Int // 0 to 100, same formula as the profile

  // Beyond the window: lets the leaderboard filter by sample size and activity
  totalMatches Int
  lastMatchAt  DateTime?

  updatedAt DateTime @updatedAt

  // Each index matches the leaderboard's ORDER BY exactly: <stat> DESC, playerId ASC.
  @@index([trackerScore(sort: Desc), playerId])
  @@index([acs(sort: Desc), playerId])
  @@index([kd(sort: Desc), playerId])
  @@index([winRate(sort: Desc), playerId])
}
